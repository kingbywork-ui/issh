doctype html
html.issh
    head
        meta(charset='UTF-8')
        meta(http-equiv='Content-Security-Policy', content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https: http: wss:")
        base(href='index.html')
        script(src='./preload.js')
        script(src='./bundle.js', defer)
        style.
            body { transition: 0.5s background; }
    body
        style#custom-css
        root
        app-root
            .preload-logo
                div
                    .issh-logo
                    h1.issh-title issh
                    .progress
                        .bar(style='width: 0%')
