h3.mb-3(translate) Host manager

ul.nav-tabs(ngbNav, #nav='ngbNav')
    li(ngbNavItem)
        a(ngbNavLink, translate) Host manager
        ng-template(ngbNavContent)
            .host-manager-layout
                .host-sidebar
                    .host-sidebar-header
                        button.btn.btn-link.p-0((click)='showAllHosts()')
                            i.fas.fa-fw.fa-bars
                            span.ms-2(translate) All

                    .host-sidebar-actions
                        button.btn.btn-sm.btn-outline-secondary((click)='showFavorites()')
                            i.fas.fa-fw.fa-star
                            span(translate) Favorites
                        button.btn.btn-sm.btn-outline-secondary((click)='showRecentHosts()')
                            i.fas.fa-fw.fa-history
                            span(translate) Recent
                        button.btn.btn-sm.btn-primary((click)='newProfileGroup()')
                            i.fas.fa-fw.fa-folder-plus
                            span(translate) New group
                        button.btn.btn-sm.btn-success((click)='newProfile()')
                            i.fas.fa-fw.fa-plus
                            span(translate) New SSH

                    .host-tree-toolbar
                        button.btn.btn-sm.btn-link((click)='showAllHosts()', [class.active]='!activeGroupId && !favoritesOnly && !recentOnly') 全部
                        button.btn.btn-sm.btn-link((click)='showFavorites()', [class.active]='favoritesOnly') 收藏
                        button.btn.btn-sm.btn-link((click)='showRecentHosts()', [class.active]='recentOnly') 最近

                    .host-tree
                        .host-tree-item.root-item(
                            (click)='showAllHosts()',
                            [class.active]='!activeGroupId && !favoritesOnly && !recentOnly'
                        )
                            i.fas.fa-fw.fa-server
                            span.ms-2 全部
                            span.count.ms-auto {{getVisibleCustomProfilesCount()}}

                        .host-tree-item.root-item(
                            (click)='showFavorites()',
                            [class.active]='favoritesOnly'
                        )
                            i.fas.fa-fw.fa-star
                            span.ms-2 收藏
                            span.count.ms-auto {{getFavoriteVisibleCount()}}

                        .host-tree-item.root-item(
                            (click)='showRecentHosts()',
                            [class.active]='recentOnly'
                        )
                            i.fas.fa-fw.fa-history
                            span.ms-2 最近
                            span.count.ms-auto {{getRecentVisibleCount()}}

                        ng-container(*ngFor='let group of rootGroups')
                            ng-container(*ngTemplateOutlet='sidebarGroup; context: {$implicit: group, level: 0}')

                .host-main
                    .host-toolbar
                        .host-toolbar-left
                            .input-group.search-group
                                .input-group-text
                                    i.fas.fa-fw.fa-search
                                input.form-control(
                                    type='search',
                                    [placeholder]='"Filter"|translate',
                                    [(ngModel)]='filter'
                                )

                            .host-filter-toggle
                                checkbox([text]='"SSH only"|translate', [(ngModel)]='sshOnly')

                            .host-filter-toggle
                                checkbox([text]='"Favorites"|translate', [(ngModel)]='favoritesOnly')

                            select.form-control.environment-filter([(ngModel)]='environmentFilter')
                                option(value='') {{'All environments'|translate}}
                                option(*ngFor='let environment of getAvailableEnvironments()', [value]='environment') {{environment}}

                            button.btn.btn-sm.btn-outline-secondary((click)='clearFilters()')
                                i.fas.fa-fw.fa-rotate-left
                                span(translate) Clear

                        .host-toolbar-right
                            button.btn.btn-sm.btn-primary((click)='newProfile()')
                                i.fas.fa-fw.fa-plus
                                span(translate) New profile

                    .bulk-toolbar(*ngIf='selectedProfileIds.size > 0')
                        .bulk-title 已选择 {{selectedProfileIds.size}} 台主机
                        .bulk-actions
                            button.btn.btn-sm.btn-outline-secondary((click)='selectVisibleProfiles()') 全选可见
                            button.btn.btn-sm.btn-outline-secondary((click)='clearSelection()') 清空选择
                            button.btn.btn-sm.btn-outline-warning((click)='bulkSetFavorite(true)') 批量收藏
                            button.btn.btn-sm.btn-outline-dark((click)='bulkSetFavorite(false)') 取消收藏
                            select.form-control.form-control-sm.bulk-select([(ngModel)]='bulkGroupId')
                                option(value='') 移动到未分组
                                option(*ngFor='let group of profileGroups', [value]='group.id') {{group.name || ("Ungrouped"|translate)}}
                            button.btn.btn-sm.btn-outline-primary((click)='bulkMoveToGroup()') 应用分组
                            input.form-control.form-control-sm.bulk-input(
                                type='text',
                                [placeholder]='"Comma-separated tags"|translate',
                                [(ngModel)]='bulkTagsInput'
                            )
                            button.btn.btn-sm.btn-outline-primary((click)='bulkReplaceTags()') {{'Apply tags'|translate}}
                            input.form-control.form-control-sm.bulk-input(
                                type='text',
                                [placeholder]='"Apply environment"|translate',
                                [(ngModel)]='bulkEnvironmentInput'
                            )
                            button.btn.btn-sm.btn-outline-primary((click)='bulkReplaceEnvironment()') {{'Apply environment'|translate}}

                    .host-list
                        ng-container(*ngFor='let group of rootGroups')
                            ng-container(*ngTemplateOutlet='hostGroup; context: {$implicit: group}')

            ng-template(#sidebarGroup let-group let-level='level')
                ng-container(*ngIf='isSidebarGroupVisible(group)')
                    .host-tree-item(
                        [style.paddingLeft.rem]='0.75 + (level * 1.1)',
                        [class.active]='isGroupActive(group)',
                        (click)='selectGroupView(group)'
                    )
                        button.btn.btn-link.tree-toggle(
                            *ngIf='group.children && group.children.length > 0',
                            (click)='$event.stopPropagation(); toggleGroupCollapse(group)'
                        )
                            i.fas.fa-fw([class.fa-chevron-right]='group.collapsed', [class.fa-chevron-down]='!group.collapsed')
                        i.far.fa-fw([class.fa-folder]='group.collapsed', [class.fa-folder-open]='!group.collapsed')
                        span.ms-2 {{group.name || ("Ungrouped"|translate)}}
                        span.count.ms-auto {{getGroupVisibleProfileCount(group)}}

                    ng-container(*ngIf='!group.collapsed')
                        ng-container(*ngFor='let child of group.children')
                            ng-container(*ngTemplateOutlet='sidebarGroup; context: {$implicit: child, level: level + 1}')

            ng-template(#hostGroup let-group)
                ng-container(*ngIf='isGroupVisible(group)')
                    .host-group-card
                        .host-group-header((click)='toggleGroupCollapse(group)')
                            .host-group-title
                                i.fas.fa-fw([class.fa-chevron-right]='group.collapsed', [class.fa-chevron-down]='!group.collapsed')
                                i.far.fa-fw([class.fa-folder]='group.collapsed', [class.fa-folder-open]='!group.collapsed')
                                span.ms-2 {{group.name || ("Ungrouped"|translate)}}
                                span.host-group-count {{getGroupVisibleProfileCount(group)}}
                            .host-group-actions
                                button.btn.btn-sm.btn-link(
                                    *ngIf='group.editable && group.name',
                                    (click)='$event.stopPropagation(); editProfileGroup(group)'
                                )
                                    i.fas.fa-pencil-alt
                                button.btn.btn-sm.btn-link(
                                    *ngIf='group.editable && group.name',
                                    (click)='$event.stopPropagation(); deleteProfileGroup(group)'
                                )
                                    i.fas.fa-trash-alt

                        ng-container(*ngIf='!group.collapsed')
                            .host-item(
                                *ngFor='let profile of getVisibleProfiles(group)',
                                [class.selected]='isSelected(profile)'
                            )
                                .host-item-leading
                                    checkbox(
                                        *ngIf='!profile.isBuiltin',
                                        [ngModel]='isSelected(profile)',
                                        (ngModelChange)='setSelection(profile, $event)'
                                    )
                                    button.btn.btn-link.favorite-toggle(
                                        *ngIf='!profile.isBuiltin',
                                        (click)='toggleFavorite(profile); $event.stopPropagation()'
                                    )
                                        i.far.fa-star(*ngIf='!profile.favorite')
                                        i.fas.fa-star.text-warning(*ngIf='profile.favorite')
                                    profile-icon([icon]='profile.icon', [color]='profile.color')

                                .host-card-content(
                                    [class.clickable]='!profile.isBuiltin',
                                    (click)='profile.isBuiltin ? null : editProfile(profile)'
                                )
                                    .host-title-row
                                        .host-title {{profile.name}}
                                        .host-title-badges
                                            span.badge.text-bg-warning(*ngIf='isRecentProfile(profile)')
                                                i.fas.fa-clock.me-1
                                                | Recent
                                            span.badge(
                                                *ngIf='profile.environment',
                                                [class]='getEnvironmentBadgeClass(profile.environment)'
                                            ) {{profile.environment}}
                                            span.badge(
                                                *ngIf='getTypeLabel(profile)',
                                                class='text-bg-{{getTypeColorClass(profile)}}'
                                            ) {{getTypeLabel(profile)}}

                                    .host-meta(*ngIf='getProfileConnectionInfo(profile) as info')
                                        span.meta-pill(*ngIf='info.user')
                                            i.fas.fa-user.fa-fw
                                            span {{info.user}}
                                        span.meta-pill(*ngIf='info.host')
                                            i.fas.fa-globe.fa-fw
                                            span {{info.host}}
                                        span.meta-pill(*ngIf='info.port')
                                            i.fas.fa-plug.fa-fw
                                            span {{info.port}}

                                    .host-description.text-muted(*ngIf='getProfileDescriptionDisplay(profile)') {{getProfileDescriptionDisplay(profile)}}
                                    .host-remark(*ngIf='profile.remark') {{profile.remark}}
                                    .host-tags(*ngIf='(profile.tags?.length ?? 0) > 0')
                                        span.badge.text-bg-secondary(*ngFor='let tag of profile.tags') {{tag}}

                                .host-item-actions
                                    button.btn.btn-sm.btn-success(*ngIf='!profile.isTemplate', (click)='launchProfile(profile)')
                                        span(translate) Connect
                                    button.btn.btn-sm.btn-outline-secondary(
                                        *ngIf='!profile.isBuiltin',
                                        (click)='editProfile(profile)'
                                    ) 编辑
                                    .hover-reveal(ngbDropdown, placement='bottom-right top-right auto')
                                        button.btn.btn-sm.btn-link(ngbDropdownToggle)
                                            i.fas.fa-fw.fa-ellipsis-vertical
                                        div(ngbDropdownMenu)
                                            button.dropdown-item(ngbDropdownItem, (click)='newProfile(profile)')
                                                i.fas.fa-fw.fa-copy
                                                span(translate) Duplicate
                                            button.dropdown-item(
                                                ngbDropdownItem,
                                                *ngIf='profile.id && !isProfileBlacklisted(profile)',
                                                (click)='blacklistProfile(profile)'
                                            )
                                                i.fas.fa-fw.fa-eye-slash
                                                span(translate) Hide
                                            button.dropdown-item(
                                                ngbDropdownItem,
                                                *ngIf='profile.id && isProfileBlacklisted(profile)',
                                                (click)='unblacklistProfile(profile)'
                                            )
                                                i.fas.fa-fw.fa-eye
                                                span(translate) Show
                                            button.dropdown-item(
                                                *ngIf='!profile.isBuiltin',
                                                (click)='deleteProfile(profile)'
                                            )
                                                i.fas.fa-fw.fa-trash-alt
                                                span(translate) Delete

                            ng-container(*ngFor='let child of group.children')
                                .host-group-children
                                    ng-container(*ngTemplateOutlet='hostGroup; context: {$implicit: child}')

    li(ngbNavItem)
        a(ngbNavLink, translate) Advanced
        ng-template(ngbNavContent)
            .form-line.content-box(*ngIf='config.store.profiles.length > 0')
                .header
                    .title(translate) Show recent profiles in selector
                    .description(translate) Set to 0 to disable recent profiles

                input.form-control(
                    type='number',
                    min='0',
                    step='1',
                    [(ngModel)]='config.store.terminal.showRecentProfiles',
                    (ngModelChange)='config.save()'
                )

            .form-line.content-box(*ngIf='config.store.profiles.length > 0')
                .header
                    .title(translate) Show built-in profiles in selector
                    .description(translate) If disabled, only custom profiles will show up in the profile selector

                toggle(
                    [(ngModel)]='config.store.terminal.showBuiltinProfiles',
                    (ngModelChange)='config.save()'
                )

            .form-line.content-box(*ngIf='hostApp.platform === Platform.Windows')
                .header
                    .title(translate) Terminal identification
                    .description(translate) How Tabby presents itself through environment vars

                select.form-control(
                    [(ngModel)]='config.store.terminal.identification',
                    (ngModelChange)='config.save()',
                )
                    option(ngValue='wt', translation) Windows Terminal
                    option(ngValue='cygwin', translation) Cygwin

            .form-line
                .header
                    .title(translate) Default "Connect to" type
                    .description(translate) Default connection type used by quick connect feature (ex. SSH, Telnet)

                select.form-control(
                    [(ngModel)]='config.store.defaultQuickConnectProvider',
                    (ngModelChange)='config.save()',
                )
                    option(
                        *ngFor='let provider of getQuickConnectProviders()',
                        [ngValue]='provider.id'
                    ) {{provider.name}}

            .form-line.content-box
                .header
                    .title(translate) Default profile settings
                    .description(translate) These apply to all profiles of a given type

            .list-group.mt-3.mb-3.content-box
                a.list-group-item.list-group-item-action.d-flex.align-items-center(
                    (click)='editDefaults(provider)',
                    *ngFor='let provider of profileProviders'
                ) {{provider.name|translate}}
                    .me-auto
                    button.btn.btn-link.hover-reveal.ms-1((click)='$event.stopPropagation(); deleteDefaults(provider)')
                        i.fas.fa-trash-arrow-up

div([ngbNavOutlet]='nav')
