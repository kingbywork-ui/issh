.modal-body([class.compact-tree]='compactTree')
    .selector-search
        i.fas.fa-search(*ngIf='compactTree')
        input.form-control(
            type='text',
            [(ngModel)]='filter',
            autofocus,
            [class.form-control-lg]='!compactTree',
            [placeholder]='name',
            (ngModelChange)='onFilterChange()'
        )

    .list-group.list-group-light(*ngIf='filteredOptions.length')
        ng-container(*ngFor='let option of filteredOptions; let i = index')
            label.group-header(
                *ngIf='hasGroups && !compactTree && option.group !== filteredOptions[i - 1]?.group'
            ) {{option.group}}
            a.list-group-item.list-group-item-action.d-flex.align-items-center(
                #item,
                (click)='selectOption(option)',
                [class.active]='selectedIndex == i',
                [class.tree-option]='compactTree',
                [style.--selector-depth]='compactTree ? getOptionDepth(option) : 0'
            )
                profile-icon(
                    [icon]='option.icon',
                    [color]='option.color'
                )
                .title.me-2 {{getOptionText(option)}}
                .description.no-wrap.text-muted(
                    *ngIf='option.description && option.description !== getOptionText(option)'
                ) {{option.description}}
                .ms-auto
                .no-wrap.badge.text-bg-secondary.ms-2.shortcut-badge(*ngIf='selectedIndex == i && canEditSelected()')
                    span BACKSPACE
                    i.fas.fa-pencil.ms-1
                .no-wrap.badge.text-bg-secondary.ms-2.shortcut-badge(*ngIf='selectedIndex == i')
                    span ENTER
                    i.fas.fa-arrow-right.ms-1
