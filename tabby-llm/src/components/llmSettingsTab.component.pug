h3.mb-3 AI 助手

.alert.alert-info
    span 连接 OpenAI 兼容 API 后，可启用 AI 命令补全和自然语言转命令。API 密钥只会本地保存到 config.yaml。

div.mt-4
    h3.mb-3 启用与连接

    .form-line
        .header
            .title 启用 AI 功能
            .description 启用 AI 命令补全、自然语言转命令等需要 LLM API 的功能。
        toggle(
            [(ngModel)]='config.store.llm.enabled',
            (ngModelChange)='config.save()'
        )

    ng-container(*ngIf='config.store.llm.enabled')
        .form-line
            .header
                .title API 基础地址
                .description OpenAI 兼容端点，例如 https://api.openai.com/v1。
            input.form-control(
                type='text',
                [(ngModel)]='config.store.llm.baseUrl',
                (keydown.enter)='saveAndTest()',
                (blur)='config.save()'
            )

        .form-line.form-line-stacked
            .header
                .title API 密钥
            .input-group
                input.form-control(
                    type='password',
                    [(ngModel)]='config.store.llm.apiKey',
                    (keydown.enter)='saveAndTest()',
                    (blur)='config.save()'
                )
                button.btn.btn-secondary(
                    (click)='saveAndTest()',
                    [disabled]='testing'
                )
                    i.fas.fa-circle-notch.fa-spin(*ngIf='testing')
                    span(*ngIf='!testing') 测试连接
                .input-group-text(*ngIf='config.store.llm.apiKey && !testing')
                    i.fas.fa-fw.fa-check.text-success(*ngIf='connectionSuccessful')
                    i.fas.fa-fw.fa-exclamation-triangle.text-danger(*ngIf='connectionSuccessful === false')

        .alert.alert-danger(*ngIf='connectionSuccessful === false')
            i.fas.fa-exclamation-triangle.me-2
            span {{ connectionError }}

        .form-line
            .header
                .title 模型
            input.form-control(
                type='text',
                [(ngModel)]='config.store.llm.model',
                (keydown.enter)='config.save()',
                (blur)='config.save()'
            )

        .form-line
            .header
                .title 补全延迟（毫秒）
            input.form-control(
                type='number',
                min='100',
                max='2000',
                [(ngModel)]='config.store.llm.debounceMs',
                (keydown.enter)='config.save()'
            )

        .form-line
            .header
                .title 发送终端上下文到 API
                .description 启用后，最近的终端输出会发送给模型辅助生成。敏感信息会先在本地脱敏。
            toggle(
                [(ngModel)]='config.store.llm.sendContextToCloud',
                (ngModelChange)='config.save()'
            )

        .form-line
            .header
                .title 最大上下文行数
                .description AI 请求中包含的最近终端输出行数。
            input.form-control(
                type='number',
                min='0',
                max='100',
                [(ngModel)]='config.store.llm.maxContextLines',
                (keydown.enter)='config.save()'
            )

        .form-line
            .header
                .title 确认时自动执行（自然语言转命令）
                .description 关闭后，确认的命令只插入终端，不自动回车执行。
            toggle(
                [(ngModel)]='config.store.llm.executeOnConfirm',
                (ngModelChange)='config.save()'
            )

div.mt-4
    h3.mb-3 命令补全

    .form-line
        .header
            .title 历史命令补全
            .description 显示基于历史命令的建议。SSH 会实时读取远程历史，本地会读取本机 shell 历史。
        toggle(
            [(ngModel)]='config.store.llm.historyAutocompleteEnabled',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title AI 命令补全
            .description 显示 AI 生成的命令建议，需要在上方启用 AI 功能。
            .section-note(*ngIf='config.store.llm.aiAutocompleteEnabled && !config.store.llm.enabled') 请先在上方启用 AI 功能。
        toggle(
            [(ngModel)]='config.store.llm.aiAutocompleteEnabled',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title 登录脚本补全（Beta）
            .description 从当前 Profile 的登录脚本中提取命令作为补全候选。
        toggle(
            [(ngModel)]='config.store.llm.scriptAutocompleteEnabled',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title 输入时自动补全
            .description 启用任一补全来源后，在输入过程中自动显示建议。
        toggle(
            [(ngModel)]='config.store.llm.autoCompleteOnType',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title 触发策略
            .description 输入首个命令词达到最小长度即自动触发补全，无需等待空格。
        toggle(
            [(ngModel)]='config.store.llm.triggerWithoutSpaceEnabled',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title 最小触发长度
            .description 输入达到该字符数后才自动触发补全。
        input.form-control(
            type='number',
            min='1',
            max='10',
            [(ngModel)]='config.store.llm.minTriggerLength',
            (keydown.enter)='config.save()'
        )

    .form-line
        .header
            .title 轻提示模式
            .description 启用后在低信心场景只显示轻提示，不主动展开完整候选列表。
        toggle(
            [(ngModel)]='config.store.llm.lightweightHintEnabled',
            (ngModelChange)='config.save()'
        )

div.mt-4
    h3.mb-3 RAG 知识库

    .form-line
        .header
            .title RAG 知识库服务
            .description 配置外部知识库服务地址，供侧边栏 /rag 查询使用。不影响命令补全。
        input.form-control(
            type='text',
            [(ngModel)]='config.store.llm.ragBaseUrl',
            (keydown.enter)='config.save()'
        )

    .form-line
        .header
            .title RAG 语义检索
            .description 启用后使用知识库的语义检索能力，否则使用基础关键词检索。
        toggle(
            [(ngModel)]='config.store.llm.ragUseSemanticSearch',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title RAG 查询数量
            .description 侧边栏 /rag 查询时从知识库返回的最大结果数。
        input.form-control(
            type='number',
            min='1',
            max='50',
            [(ngModel)]='config.store.llm.ragTopK',
            (keydown.enter)='config.save()'
        )
