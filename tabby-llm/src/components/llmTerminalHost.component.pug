autocomplete-panel(
    [visible]='controller?.showAutocomplete',
    [suggestions]='controller?.suggestions ?? []',
    [aiLoading]='controller?.aiLoading',
    [position]='controller?.panelPosition ?? {x:0,y:0}',
    [selectedIndex]='controller?.selectedIndex ?? 0',
    (selectSuggestion)='onSelectSuggestion($event)',
    (dismiss)='onAutocompleteDismiss()',
    (selectedIndexChange)='onSelectedIndexChange($event)'
)
command-sidecar(
    [visible]='controller?.sidecarVisible',
    [mode]='controller?.sidecarMode ?? "rag"',
    [inputText]='controller?.sidecarInput ?? ""',
    [loading]='controller?.sidecarLoading',
    [ragResults]='controller?.sidecarRagResults ?? []',
    [selectedIndex]='controller?.sidecarSelectedIndex ?? 0',
    [commandDetail]='controller?.sidecarCommandDetail ?? null',
    [errorText]='controller?.sidecarError ?? ""',
    [aiCommand]='controller?.sidecarAICommand ?? ""',
    [aiExplanation]='controller?.sidecarAIExplanation ?? ""',
    [aiDangerous]='controller?.sidecarAIDangerous',
    [aiDangerReason]='controller?.sidecarAIDangerReason ?? ""',
    (inputTextChange)='onSidecarInput($event)',
    (submitInput)='onSidecarSubmit()',
    (dismiss)='onSidecarDismiss()',
    (clear)='onSidecarClear()',
    (selectRagResult)='onSidecarSelectRagResult($event)',
    (insertRagResult)='onSidecarInsertRagResult($event)',
    (insertAIResult)='onSidecarInsertAIResult()',
    (runAIResult)='onSidecarRunAIResult()',
    (moveNext)='onSidecarMoveNext()',
    (movePrev)='onSidecarMovePrev()',
    (insertCurrent)='onSidecarInsertCurrent()'
)
