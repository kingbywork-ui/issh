.command-sidecar(*ngIf='visible', (mousedown)='$event.stopPropagation()')
    .sidecar-header
        .mode-pill([class.ai]='mode === "ai"') {{ mode === 'rag' ? '/rag' : '/ai' }}
        .title {{ mode === 'rag' ? '命令用法' : 'AI 对话' }}
        button.btn.btn-sm.btn-link.ms-auto((click)='clear.emit()', title='清空')
            i.fas.fa-eraser
        button.btn.btn-sm.btn-link((click)='dismiss.emit()', title='关闭')
            i.fas.fa-times

    .sidecar-body
        .loading-row(*ngIf='loading')
            i.fas.fa-circle-notch.fa-spin.me-2
            span {{ mode === 'rag' ? '查询命令知识库...' : '生成命令...' }}

        .error-row(*ngIf='!loading && errorText')
            i.fas.fa-exclamation-triangle.me-2
            span {{ errorText }}

        ng-container(*ngIf='!loading && !errorText && mode === "rag"')
            .empty-row(*ngIf='!ragResults.length && !commandDetail') 输入 /rag dnf 查询命令用法

            .result-list(*ngIf='ragResults.length')
                .result-item(
                    *ngFor='let item of ragResults; let i = index',
                    [class.selected]='i === selectedIndex',
                    (click)='selectRagResult.emit(item)'
                )
                    .command-line
                        code {{ item.command }}
                        button.btn.btn-sm.btn-link.ms-auto((click)='$event.stopPropagation(); insertRagResult.emit(item)', title='插入命令')
                            i.fas.fa-terminal
                    .description(*ngIf='item.description') {{ item.description }}

            .detail-panel(*ngIf='commandDetail')
                .detail-title {{ commandDetail.name }}
                .detail-desc(*ngIf='commandDetail.description') {{ commandDetail.description }}

                .detail-section(*ngIf='commandDetail.useCases?.length')
                    .section-title 常见用途
                    .use-case(*ngFor='let useCase of commandDetail.useCases') {{ useCase }}

                .detail-section(*ngIf='commandDetail.examples?.length')
                    .section-title 示例
                    code.example(*ngFor='let example of commandDetail.examples') {{ example }}

                .detail-section(*ngIf='commandDetail.options?.length')
                    .section-title 常用参数
                    .option-row(*ngFor='let option of commandDetail.options')
                        code {{ option.flag }}
                        span {{ option.description }}

                .tag-row(*ngIf='commandDetail.tags?.length')
                    span.tag(*ngFor='let tag of commandDetail.tags') {{ tag }}

        ng-container(*ngIf='!loading && !errorText && mode === "ai"')
            .empty-row(*ngIf='!aiCommand') 输入 /ai 查看 nginx 状态
            .ai-result(*ngIf='aiCommand')
                .section-title 建议命令
                pre.command-preview([class.danger]='aiDangerous') {{ aiCommand }}
                .detail-desc(*ngIf='aiExplanation') {{ aiExplanation }}
                .danger-row(*ngIf='aiDangerous')
                    i.fas.fa-exclamation-triangle.me-2
                    span {{ aiDangerReason || '此命令可能有风险' }}
                .action-row
                    button.btn.btn-sm.btn-success((click)='runAIResult.emit()')
                        i.fas.fa-play.me-1
                        span 执行
                    button.btn.btn-sm.btn-secondary.ms-2((click)='insertAIResult.emit()')
                        i.fas.fa-terminal.me-1
                        span 插入

    .sidecar-input
        input.form-control.form-control-sm(
            #inputField,
            type='text',
            [value]='inputText',
            (input)='onInput($event.target.value)',
            (keydown)='onKeydown($event)',
            (keydown.enter)='!$event.ctrlKey && submitInput.emit()',
            placeholder='/rag dnf 或 /ai 查看 nginx 状态'
        )
        button.btn.btn-sm.btn-primary.ms-2(
            (click)='submitInput.emit()',
            [disabled]='loading || !inputText.trim()'
        )
            i.fas.fa-paper-plane
