.autocomplete-panel(
    *ngIf='visible',
    (mousedown)='$event.preventDefault()'
)
    .panel-header
        span(translate) Suggestions
        .ai-loading(*ngIf='aiLoading')
            i.fas.fa-circle-notch.fa-spin.me-1
            span(translate) AI...
        button.btn.btn-sm.btn-link((click)='dismiss.emit()')
            i.fas.fa-times

    .suggestion-list(*ngIf='suggestions.length')
        .suggestion-item(
            *ngFor='let item of suggestions; let i = index',
            [class.selected]='i === selectedIndex',
            (click)='select(item)'
        )
            .suggestion-row
                span.category-tag(
                    *ngIf='item.category === "history"',
                    class='history'
                ) History
                span.category-tag(
                    *ngIf='item.category === "ai"',
                    class='ai'
                ) AI
                span.category-tag(
                    *ngIf='item.category === "script"',
                    class='script'
                ) Script
                span.category-tag(
                    *ngIf='item.category === "rag"',
                    class='rag'
                ) RAG
                .command {{ item.command }}
            .description(*ngIf='item.description && item.category !== "history"') {{ item.description }}

    .loading-row(*ngIf='aiLoading && !suggestions.length')
        i.fas.fa-circle-notch.fa-spin.me-2
        span(translate) Thinking...

    .empty-row(*ngIf='!aiLoading && !suggestions.length')
        span(translate) No suggestions
