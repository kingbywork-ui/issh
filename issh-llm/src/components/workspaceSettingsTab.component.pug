h3.mb-3 Agent Workspace

.alert.alert-info
    strong Rust Runtime 工作区
    div 将当前打开的终端会话绑定到 Workspace，供外部 MCP 智能体共享同一组真实 SSH 窗口。会话仍由 issh 管理。

.alert.alert-danger(*ngIf='error') {{ error }}

.llm-section
    .llm-section-header
        .llm-section-icon
            i.fas.fa-heartbeat
        .llm-section-meta
            .llm-section-title Runtime 状态
            .llm-section-desc(*ngIf='runtimeHealth') 协议 {{ runtimeHealth.protocolVersion }} · Runtime {{ runtimeHealth.runtimeVersion }} · PID {{ runtimeHealth.pid }}
            .llm-section-desc(*ngIf='cordisHealth') Cordis Fibers {{ cordisHealth.cordisFibers }} · 活跃编排 {{ cordisHealth.activeRuns }}
            .llm-section-desc(*ngIf='!runtimeHealth') 尚未连接
        button.btn.btn-secondary.btn-sm(type='button', (click)='refresh()', [disabled]='loading')
            i.fas.fa-circle-notch.fa-spin.me-1(*ngIf='loading')
            i.fas.fa-sync-alt.me-1(*ngIf='!loading')
            span 刷新

.llm-section
    .llm-section-header
        .llm-section-icon
            i.fas.fa-network-wired
        .llm-section-meta
            .llm-section-title Herdr 可选适配器
            .llm-section-desc(*ngIf='herdrStatus?.running && herdrStatus?.compatible') 已连接 Herdr {{ herdrStatus.version }} · 协议 {{ herdrStatus.protocol }} · {{ herdrStatus.managed ? '由 issh 管理' : '外部管理' }}
            .llm-section-desc(*ngIf='!herdrStatus?.running') Native-only 降级模式：Herdr 缺失或停止不会影响 issh Workspace 和 SSH 会话。
            .llm-section-desc.text-danger(*ngIf='herdrStatus?.lastError') {{ herdrStatus.lastError }}
    .llm-section-body
        .form-check.mb-2
            input.form-check-input(type='checkbox', id='herdr-enabled', [(ngModel)]='config.store.llm.herdrEnabled', (change)='saveHerdrSettings()')
            label.form-check-label(for='herdr-enabled') 启用 Herdr 可选集成
        .form-check.mb-3
            input.form-check-input(type='checkbox', id='herdr-autostart', [(ngModel)]='config.store.llm.herdrAutoStart', (change)='saveHerdrSettings()', [disabled]='!config.store.llm.herdrEnabled')
            label.form-check-label(for='herdr-autostart') 启动 issh 时自动启动并在崩溃后有限重连
        .row.mb-3
            .col-md-7
                label Herdr 可执行文件（留空使用 PATH）
                input.form-control(type='text', [(ngModel)]='config.store.llm.herdrBinaryPath', placeholder='例如 C:\\Tools\\herdr.exe', (change)='saveHerdrSettings()')
            .col-md-5
                label 独立 Session
                input.form-control(type='text', maxlength='64', [(ngModel)]='config.store.llm.herdrSession', placeholder='issh', (change)='saveHerdrSettings()')
        .d-flex.flex-wrap
            button.btn.btn-primary.btn-sm.me-2(type='button', (click)='startHerdr()', [disabled]='herdrBusy || !config.store.llm.herdrEnabled') 启动 / 连接
            button.btn.btn-outline-danger.btn-sm(type='button', (click)='stopHerdr()', [disabled]='herdrBusy || !herdrStatus?.running') 停止 issh 所属 sidecar
        small.text-muted.d-block.mt-2 常规同步仅发送 Workspace 标识和 Agent/Task 聚合计数。只有明确点击“接管并打开”时，选定 pane 的 ANSI 字节流才会进入本机 issh xterm；SSH 凭据和主 Agent Bridge token 始终不会传给 Herdr。
        .mt-3(*ngIf='selectedWorkspaceId && herdrStatus?.running && herdrStatus?.compatible')
            label Herdr Workspace 映射
            .input-group
                select.form-control([(ngModel)]='selectedHerdrWorkspaceId', (ngModelChange)='selectHerdrWorkspace($event)')
                    option(value='') 选择 Herdr Workspace
                    option(*ngFor='let workspace of herdrWorkspaces', [value]='workspace.workspace_id') {{ workspace.label || workspace.workspace_id }}
                .input-group-append
                    button.btn.btn-secondary(type='button', (click)='linkHerdrWorkspace()', [disabled]='!selectedHerdrWorkspaceId || herdrBusy') 关联并同步
                    button.btn.btn-outline-secondary(type='button', *ngIf='herdrLinkedWorkspaceId', (click)='syncHerdrWorkspace()', [disabled]='herdrBusy') 同步
                    button.btn.btn-outline-danger(type='button', *ngIf='herdrLinkedWorkspaceId', (click)='unlinkHerdrWorkspace()', [disabled]='herdrBusy') 解除
            small.text-muted.d-block.mt-1(*ngIf='herdrLinkedWorkspaceId') 当前关联：{{ herdrLinkedWorkspaceId }}
            .mt-3
                label Herdr 实时终端
                .text-muted.mb-2(*ngIf='!herdrPanes.length') 当前 Herdr Workspace 没有可打开的 pane。
                .d-flex.align-items-center.justify-content-between.border.rounded.p-2.mb-2(*ngFor='let pane of herdrPanes')
                    div
                        strong {{ pane.title }}
                        small.text-muted.d-block {{ pane.paneId }} · {{ pane.cwd || '工作目录未知' }}
                    button.btn.btn-outline-primary.btn-sm(type='button', (click)='openHerdrPane(pane)', [disabled]='herdrBusy')
                        i.fas.fa-external-link-alt.me-1
                        span 接管并打开

.llm-section
    .llm-section-header
        .llm-section-icon
            i.fas.fa-layer-group
        .llm-section-meta
            .llm-section-title Workspace
            .llm-section-desc 创建协作空间并选择当前要管理的空间。
    .llm-section-body
        .d-flex.align-items-center.mb-3
            input.form-control.me-2(type='text', maxlength='120', placeholder='例如：生产环境巡检', [(ngModel)]='workspaceName', (keydown.enter)='createWorkspace()')
            button.btn.btn-primary(type='button', (click)='createWorkspace()', [disabled]='!workspaceName.trim()') 创建
        select.form-control(*ngIf='workspaces.length', [(ngModel)]='selectedWorkspaceId', (ngModelChange)='selectWorkspace()')
            option(*ngFor='let workspace of workspaces', [value]='workspace.id') {{ workspace.name }}（{{ workspace.bindings.length }} 个会话）
        .text-muted(*ngIf='!workspaces.length && !loading') 尚无 Workspace。

.llm-section
    .llm-section-header
        .llm-section-icon
            i.fas.fa-terminal
        .llm-section-meta
            .llm-section-title 打开的终端会话
            .llm-section-desc 绑定后，智能体可以通过 Workspace 发现这些会话；点击“聚焦”切回对应 tab。
    .llm-section-body
        .text-muted(*ngIf='!sessions.length') 当前没有打开的终端会话。
        .d-flex.align-items-center.border-bottom.py-2(*ngFor='let session of sessions')
            input.me-2(type='checkbox', [checked]='isBound(session.id)', [disabled]='!selectedWorkspaceId', (change)='toggleBinding(session.id)')
            .flex-grow-1
                .font-weight-bold {{ session.title || session.profileName || session.id }}
                small.text-muted.d-block {{ session.user || '' }}{{ session.user && session.host ? '@' : '' }}{{ session.host || session.profileType || 'terminal' }} · {{ session.connected ? '已连接' : '未连接' }}
            span.badge.badge-success.me-2(*ngIf='session.active') 当前
            button.btn.btn-secondary.btn-sm(type='button', (click)='focusSession(session.id)') 聚焦

.llm-section(*ngIf='selectedWorkspaceId')
    .llm-section-header
        .llm-section-icon
            i.fas.fa-user-cog
        .llm-section-meta
            .llm-section-title 单 Agent 执行器
            .llm-section-desc Agent 读取所绑定终端的脱敏上下文并生成建议；不会直接执行终端命令。
    .llm-section-body
        .row.mb-3
            .col-md-5
                input.form-control(type='text', maxlength='120', placeholder='Agent 名称', [(ngModel)]='agentName')
            .col-md-5
                select.form-control([(ngModel)]='selectedSessionId')
                    option(value='') 不绑定终端上下文
                    option(*ngFor='let session of sessions', [value]='session.id', [disabled]='!isBound(session.id)') {{ session.title || session.profileName || session.id }}{{ isBound(session.id) ? '' : '（需先绑定）' }}
            .col-md-2
                button.btn.btn-primary.btn-block(type='button', (click)='registerAgent()', [disabled]='!agentName.trim() || detailLoading') 注册
        .form-check.mb-3
            input.form-check-input(type='checkbox', id='agent-command-execute', [(ngModel)]='agentCanExecute')
            label.form-check-label(for='agent-command-execute') 允许该 Agent 在用户明确点击后执行结果中的命令
            small.text-muted.d-block 默认关闭；危险命令无论此权限如何都必须经过 issh 原生确认框。
        .text-muted.mb-3(*ngIf='!agents.length') 当前 Workspace 尚无 Agent。
        .form-group(*ngIf='agents.length')
            label 目标 Agent
            select.form-control([(ngModel)]='selectedAgentId')
                option(*ngFor='let agent of agents', [value]='agent.id') {{ agent.name }} · {{ agent.sessionId ? '已绑定终端' : '无终端上下文' }}
            small.text-muted.d-block.mt-1(*ngFor='let agent of agents') {{ agent.name }} scopes：{{ agent.scopes.join(', ') }}
        .form-group(*ngIf='agents.length')
            label 任务提示
            textarea.form-control(rows='3', maxlength='16000', placeholder='描述要分析的问题或下一步操作；Agent 只返回建议。', [(ngModel)]='agentPrompt')
        button.btn.btn-primary(type='button', *ngIf='agents.length', (click)='promptAgent()', [disabled]='!agentPrompt.trim() || prompting')
            i.fas.fa-circle-notch.fa-spin.me-1(*ngIf='prompting')
            span {{ prompting ? '等待结果…' : '发起任务' }}

.llm-section(*ngIf='selectedWorkspaceId && agents.length')
    .llm-section-header
        .llm-section-icon
            i.fas.fa-project-diagram
        .llm-section-meta
            .llm-section-title Cordis 多 Agent 编排
            .llm-section-desc 同一 Workspace 内并行调度；取消会 dispose 对应 Fiber 并终止所有未完成任务。
    .llm-section-body
        .border-bottom.py-2(*ngFor='let agent of agents')
            label.mb-0
                input.me-2(type='checkbox', [checked]='isAgentSelected(agent.id)', (change)='toggleAgentSelection(agent.id)')
                span {{ agent.name }}
                small.text-muted.ms-2 {{ agent.sessionId || '无终端上下文' }}
        .form-group.mt-3
            label 共享任务提示（已选 {{ selectedAgentIds.length }} 个 Agent）
            textarea.form-control(rows='3', maxlength='16000', [(ngModel)]='multiAgentPrompt', placeholder='例如：分别检查各自主机的服务状态并给出汇总建议。')
        button.btn.btn-primary(type='button', (click)='dispatchAgents()', [disabled]='!selectedAgentIds.length || !multiAgentPrompt.trim() || dispatching')
            i.fas.fa-circle-notch.fa-spin.me-1(*ngIf='dispatching')
            span {{ dispatching ? '等待编排结果…' : '并行调度' }}
        .mt-3(*ngIf='runs.length')
            .d-flex.align-items-center.border-bottom.py-2(*ngFor='let run of runs')
                .flex-grow-1
                    strong {{ run.id }}
                    small.text-muted.d-block {{ run.status }} · {{ run.taskIds.length }} 个任务
                button.btn.btn-outline-danger.btn-sm(type='button', *ngIf="run.status === 'running'", (click)='cancelRun(run.id)') 取消编排

.llm-section(*ngIf='selectedWorkspaceId')
    .llm-section-header
        .llm-section-icon
            i.fas.fa-tasks
        .llm-section-meta
            .llm-section-title 任务与恢复状态
            .llm-section-desc Runtime 重启时未完成任务会标记为“中断”，不会被误报为成功。
    .llm-section-body
        .text-muted(*ngIf='!tasks.length') 暂无任务。
        .border-bottom.py-3(*ngFor='let task of tasks')
            .d-flex.align-items-center
                .flex-grow-1
                    strong {{ task.prompt }}
                    small.text-muted.d-block {{ taskStatusText(task.status) }} · {{ task.createdAtUnixMs | date:'short' }}
                button.btn.btn-outline-danger.btn-sm(type='button', *ngIf='!isTaskTerminal(task)', (click)='cancelTask(task.id)') 取消
            pre.mt-2.mb-0.text-wrap(*ngIf='task.output') {{ task.output }}
            .alert.alert-danger.mt-2.mb-0(*ngIf='task.error') {{ task.error }}
            .input-group.mt-2(*ngIf="task.status === 'completed' && agentCanRunCommands(task.agentId)")
                input.form-control(type='text', [(ngModel)]='taskCommands[task.id]', placeholder='粘贴结果中建议的完整命令')
                .input-group-append
                    button.btn.btn-secondary(type='button', (click)='runTaskCommand(task, false)') 仅预览
                    button.btn.btn-danger(type='button', (click)='runTaskCommand(task, true)') 明确执行

.llm-section(*ngIf='selectedWorkspaceId')
    .llm-section-header
        .llm-section-icon
            i.fas.fa-history
        .llm-section-meta
            .llm-section-title 最近事件
            .llm-section-desc 按持久化序号展示最近 50 条 Workspace 事件，供恢复和审计定位。
    .llm-section-body
        .text-muted(*ngIf='!events.length') 暂无事件。
        small.d-block.border-bottom.py-1(*ngFor='let event of events') 序号 {{ event.sequence }} · {{ event.kind }} · {{ event.createdAtUnixMs | date:'short' }}
